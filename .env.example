# ===================================================================
# CSE494 - Turf Booking Management System Configuration
# Copy this file to '.env' and update with your MongoDB Atlas details.
# DO NOT COMMIT YOUR REAL '.env' FILE TO GITHUB!
# ===================================================================

# MongoDB Atlas Connection String
# Get this from MongoDB Atlas -> Database -> Connect -> Drivers -> Python
# Example format:
# MONGO_URI=mongodb+srv://student_user:mySecretPassword123@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/?retryWrites=true&w=majority

# Flask Secret Key for session and flash messages
SECRET_KEY=cse494-turf-booking-secret-key-2026

# Server Port (optional, default 5000)
PORT=5000

